# Copie para .env na pasta do projeto no NAS (ex.: /volume1/docker/estante) e preencha.
# Usado pelo docker-compose.synology.yml. NUNCA suba o .env para o git.
# Passo a passo: docs/deploy-synology.md.

# Senha de acesso à biblioteca (obrigatória). Gere uma forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Sem espaços e sem aspas, porque o arquivo é lido pelo shell.
LIB_PSWD=

# Pasta dos livros no NAS (obrigatória). Caminho absoluto, montado somente leitura.
LIVROS_HOST_DIR=/volume1/livros

# Porta local do container no NAS. 80 e 443 são do DSM; o reverse proxy HTTPS do DSM aponta para esta porta.
HTTP_PORT=8080

# Cookie de sessão Secure. Em produção deixe true: o login só se mantém via HTTPS (domínio do reverse proxy).
# Use false apenas para testar via http://IP:8080.
SESSION_COOKIE_SECURE=true

# Usuário que roda o app no container e é dono do cache (build args do Dockerfile).
# Use o uid/gid de um usuário do NAS (veja com "id <usuario>" no SSH; ex.: 1026 e 100).
# Mudou? Rode "docker compose -f docker-compose.synology.yml build" e: chown -R APP_UID:APP_GID data/cache
APP_UID=1000
APP_GID=1000

# Pasta do cache no NAS (opcional). Padrão: data/cache dentro da pasta do projeto.
# Capas e chave de sessão. Precisa pertencer a APP_UID:APP_GID (ver docs/deploy-synology.md).
# CACHE_DIR=./data/cache
